            "request": "launch",
            "mainClass": "www.ontologyutils.apps.RepairWithPowerIndexes",
            "projectName": "ontologyutils",
            "args": "src/test/resources/inconsistent/pizza.owl --preset bernard2023 --power-index-shapley-approximate --verbose --normalize"
        },
        {
            "type": "java",
            "name": "RepairComparisonExperiment (xeo)",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.RepairComparisonExperiment",
            "projectName": "ontologyutils",
            "args": "src/test/resources/ekaw26/cleanup/xeo.owl"
        },
        {
            "type": "java",
            "name": "RepairComparisonExperiment (debug vmArgs)",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.RepairComparisonExperiment",
            "projectName": "ontologyutils",
            "vmArgs": "-Dontologyutils.powerindex.debug=true -Xms1g -Xmx8g -Xss8m --enable-native-access=ALL-UNNAMED"
        },
        {
            "type": "java",
            "name": "SingleTrialExperiment (elig seed 13)",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.SingleTrialExperiment",
            "projectName": "ontologyutils",
            "args": "--ontology src/test/resources/ekaw26/cleanup/elig.owl --seed 13 --out src/test/resources/ekaw26/cleanup/elig.csv",
            "vmArgs": "-Xms1g -Xmx8g -Xss8m --enable-native-access=ALL-UNNAMED"
        }
    ]
