            "request": "launch",
            "mainClass": "www.ontologyutils.apps.RepairWithPowerIndexes",
            "projectName": "ontologyutils",
            "args": "src/test/resources/ekaw26/inconsistent/taxrank.owl --preset troquard2018 --power-index-shapley-approximate --verbose --normalize"
        },
        {
            "type": "java",
            "name": "leftpolicies shapley exact",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.RepairWithPowerIndexes",
            "projectName": "ontologyutils",
            "args": "src/test/resources/inconsistent/paper-example.owl --preset troquard2018 --power-index-shapley-exact --verbose --normalize"
        },
        {
            "type": "java",
            "name": "leftpolicies-small shapley exact",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.RepairWithPowerIndexes",
            "projectName": "ontologyutils",
            "args": "src/test/resources/inconsistent/leftpolicies-small.owl --preset troquard2018 --power-index-shapley-exact --normalize --verbose"
