    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "java",
            "name": "ClassifyOntology",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.ClassifyOntology",
            "projectName": "ontologyutils",
            "args": "src/test/resources/ekaw26/inconsistent/elig.owl"
        },
        {
            "type": "java",
            "name": "CleanupOntology",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.CleanupOntology",
            "projectName": "ontologyutils",
            "args": "src/test/resources/ekaw26/original/xao.owl --output src/test/resources/ekaw26/cleanup/xao.owl"
        },
        {
            "type": "java",
            "name": "MakeInconsistent",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.MakeInconsistent",
            "projectName": "ontologyutils",
            "args": "src/test/resources/ekaw26/cleanup/xao.owl --output src/test/resources/ekaw26/inconsistent/xao.owl --normalize --basic-cache --strict-sroiq --strict-simple-roles --simple-ria-weakening --strict-owl2 --verbose"
        },
        {
            "type": "java",
            "name": "dangerous-example shapley exact",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.RepairWithPowerIndexes",
            "projectName": "ontologyutils",
            "args": "src/test/resources/inconsistent/dangerous-example.owl --preset troquard2018 --power-index-shapley-exact --verbose --normalize"
        },
        {
            "type": "java",
            "name": "dangerous-example shapley exact (interactive)",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.RepairWithPowerIndexesInteractive",
            "projectName": "ontologyutils",
            "args": "src/test/resources/inconsistent/dangerous-example.owl --preset troquard2018-shapley-exact --verbose --normalize"
        },
        {
            "type": "java",
            "name": "elig shapley approx",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.RepairWithPowerIndexes",
            "projectName": "ontologyutils",
            "args": "src/test/resources/ekaw26/original/elig.owl --preset troquard2018 --power-index-shapley-approximate --verbose --normalize"
        },
        {
