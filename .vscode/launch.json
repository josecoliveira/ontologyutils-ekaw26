            "request": "launch",
            "mainClass": "www.ontologyutils.apps.MakeInconsistent",
            "projectName": "ontologyutils",
            "args": "src/test/resources/ekaw26/inconsistent/bpt.owl --output src/test/resources/ekaw26/inconsistent/bpt.owl --normalize --basic-cache --strict-sroiq --strict-simple-roles --simple-ria-weakening --strict-owl2"
        },
        {
            "type": "java",
            "name": "MakeInconsistent (cctoo)",
            "request": "launch",
            "mainClass": "www.ontologyutils.apps.MakeInconsistent",
