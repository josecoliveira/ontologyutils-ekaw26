is_a: urn:agi-folder:digestive_system ! Digestive system
is_a: urn:agi-folder:peptide_and_protein_hormones ! Peptide and protein hormones
xref: PS:Description "Somatostatins block insulin secretion by alpha and beta cells in the pancreas. Pathway is built manually using published studies."
synonym: "Description: Somatostatins block insulin secretion by alpha and beta cells in the pancreas. Pathway is built manually using published studies." EXACT []
xref: PS:PMID "15927701"
xref: PS:PMID "11230804"
synonym: "PMID: 15927701" EXACT []
synonym: "PMID: 11230804" EXACT []
xref: PS:Pathway_Author "A. Nesterova ORCID:0000-0002-9448-8101"
synonym: "Pathway_Author: A. Nesterova ORCID:0000-0002-9448-8101" EXACT []
