xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:digestive_system ! Digestive system
is_a: urn:agi-folder:systemic_effects_in_inflammation ! Systemic effects in inflammation
