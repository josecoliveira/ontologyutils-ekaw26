id: urn:agi-pathway:uuid-9da9fe29-2077-4156-a5f4-ec16c3002449
name: Transcytosis
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:secretory_vesicle ! Secretory vesicle
is_a: urn:agi-folder:intracellular_transport ! Intracellular transport
is_a: urn:agi-folder:generic ! Generic
is_a: urn:agi-folder:t ! T
is_a: urn:agi-folder:plasma_membrane ! Plasma membrane
xref: PS:Description "Transcytosis is the process where membrane-bound carriers selectively transport molecules between different parts of the cell. Pathway is built manually using published studies."
synonym: "Description: Transcytosis is the process where membrane-bound carriers selectively transport molecules between different parts of the cell. Pathway is built manually using published studies." EXACT []
