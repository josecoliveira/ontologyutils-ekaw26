name: 1_Microangiopathy in diabetic neuropathy
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:1 ! 1
is_a: urn:agi-folder:diabetic_neuropathy ! Diabetic neuropathy
