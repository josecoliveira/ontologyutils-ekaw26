id: urn:agi-pathway:uuid-3159107d-0a9e-46e5-be82-39062ba9b264
name: CCR5 Signaling in Macrophages
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:lymphatic_system ! Lymphatic system
is_a: urn:agi-folder:blood ! Blood
is_a: urn:agi-folder:c ! C
is_a: urn:agi-folder:hiv_type_1_infection ! HIV type 1 infection
xref: PS:Description "Human immunodeficiency virus (HIV) is a lentivirus that causes acquired immunodeficiency syndrome (AIDS) in which infections and cancers occur. Pathway is built manually using published studies."
synonym: "Description: Human immunodeficiency virus (HIV) is a lentivirus that causes acquired immunodeficiency syndrome (AIDS) in which infections and cancers occur. Pathway is built manually using published studies." EXACT []
