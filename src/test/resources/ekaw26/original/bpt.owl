synonym: "Link: https://mammal-profservices.pathwaystudio.com/app/sd?urn=urn:agi-pathway:uuid-52953675-7d76-44bc-92f4-b608944be0e1" EXACT []
xref: PS:CellType "neuron"
xref: PS:CellType "astrocyte"
synonym: "CellType: neuron" EXACT []
synonym: "CellType: astrocyte" EXACT []
