id: urn:agi-pathway:uuid-5e2ea56b-9137-41f3-80aa-2022b59f5a9d
name: CD8+ T-Cell Action Impairment in HIV Type 1 Infection
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:lymphatic_system ! Lymphatic system
is_a: urn:agi-folder:blood ! Blood
