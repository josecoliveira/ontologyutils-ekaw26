id: urn:agi-pathway:uuid-7a05793a-30d8-4e9d-9482-c609473347dd
name: CC Chemokine Receptor Signaling
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:chemotaxis ! Chemotaxis
is_a: urn:agi-folder:generic ! Generic
is_a: urn:agi-folder:c ! C
xref: PS:Description "The CC chemokine proteins have two adjacent cysteine residues near their amino terminus. Pathway is built manually using published studies."
synonym: "Description: The CC chemokine proteins have two adjacent cysteine residues near their amino terminus. Pathway is built manually using published studies." EXACT []
