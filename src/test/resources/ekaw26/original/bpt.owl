id: urn:agi-pathway:uuid-15a3ccf6-c96c-4ff0-a849-1e28bb0fad2c
name: rRNA Transcription and Processing
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:nucleus ! Nucleus
is_a: urn:agi-folder:r ! R
is_a: urn:agi-folder:rna_transcription ! RNA transcription
is_a: urn:agi-folder:generic ! Generic
xref: PS:Description "The function of rRNA is to provide a mechanism for decoding mRNA into amino acids at the center of a small ribosomal subunit and to interact with tRNAs during translation. Pathway is built manually using published studies."
synonym: "Description: The function of rRNA is to provide a mechanism for decoding mRNA into amino acids at the center of a small ribosomal subunit and to interact with tRNAs during translation. Pathway is built manually using published studies." EXACT []
xref: PS:Pathway_Author "A. Nesterova ORCID:0000-0002-9448-8101"
synonym: "Pathway_Author: A. Nesterova ORCID:0000-0002-9448-8101" EXACT []
