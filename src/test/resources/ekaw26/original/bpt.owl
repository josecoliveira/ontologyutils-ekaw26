id: urn:agi-pathway:uuid-7cb2c182-35f2-43e3-a922-9e7e40eef522
name: Nuclear Envelope in Cell Division
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:nucleus ! Nucleus
is_a: urn:agi-folder:generic ! Generic
is_a: urn:agi-folder:cell_division ! Cell division
is_a: urn:agi-folder:plasma_membrane ! Plasma membrane
is_a: urn:agi-folder:n ! N
xref: PS:Description "During mitosis, the nuclear envelope (NE) is completely disassembled and removed from the chromatin. Pathway is built manually using published studies."
synonym: "Description: During mitosis, the nuclear envelope (NE) is completely disassembled and removed from the chromatin. Pathway is built manually using published studies." EXACT []
xref: PS:Pathway_Author "A. Nesterova ORCID:0000-0002-9448-8101"
synonym: "Pathway_Author: A. Nesterova ORCID:0000-0002-9448-8101" EXACT []
xref: PS:Link "https://mammal-profservices.pathwaystudio.com/app/sd?urn=urn:agi-pathway:uuid-7cb2c182-35f2-43e3-a922-9e7e40eef522"
synonym: "Link: https://mammal-profservices.pathwaystudio.com/app/sd?urn=urn:agi-pathway:uuid-7cb2c182-35f2-43e3-a922-9e7e40eef522" EXACT []
