id: urn:agi-pathway:uuid-751e1983-7ca1-48b4-bda1-4634dfa0d90a
name: Complement Alternative Pathway
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:hematological_system ! Hematological system
is_a: urn:agi-folder:generic ! Generic
is_a: urn:agi-folder:complement_activation ! Complement activation
is_a: urn:agi-folder:c ! C
is_a: urn:agi-folder:plasma_membrane ! Plasma membrane
xref: PS:Description "The complement system is a component of innate immunity that consists of multiple plasma proteins that function either as enzymes or binding proteins. Pathway is built manually using published studies."
synonym: "Description: The complement system is a component of innate immunity that consists of multiple plasma proteins that function either as enzymes or binding proteins. Pathway is built manually using published studies." EXACT []
xref: PS:Pathway_Author "A. Nesterova ORCID:0000-0002-9448-8101"
synonym: "Pathway_Author: A. Nesterova ORCID:0000-0002-9448-8101" EXACT []
xref: PS:Link "https://mammal-profservices.pathwaystudio.com/app/sd?urn=urn:agi-pathway:uuid-751e1983-7ca1-48b4-bda1-4634dfa0d90a"
synonym: "Link: https://mammal-profservices.pathwaystudio.com/app/sd?urn=urn:agi-pathway:uuid-751e1983-7ca1-48b4-bda1-4634dfa0d90a" EXACT []
