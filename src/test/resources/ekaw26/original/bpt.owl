synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:secretory_vesicle ! Secretory vesicle
is_a: urn:agi-folder:intracellular_transport ! Intracellular transport
is_a: urn:agi-folder:generic ! Generic
is_a: urn:agi-folder:plasma_membrane ! Plasma membrane
is_a: urn:agi-folder:e ! E
xref: PS:Description "The vesicle docking is a step of exocytosis which represents the molecular interactions underlying the tight association of a vesicle with its target membrane. Pathway is built manually using published studies."
synonym: "Description: The vesicle docking is a step of exocytosis which represents the molecular interactions underlying the tight association of a vesicle with its target membrane. Pathway is built manually using published studies." EXACT []
