name: 4_Inflammatory mediators inhibit GATA signaling in erythropoiesis
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:anemia ! Anemia
is_a: urn:agi-folder:4 ! 4
