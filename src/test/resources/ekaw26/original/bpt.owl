name: 1_Insufficient activation of immune response in the middle ear epithelium cells in otitis media
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:1 ! 1
is_a: urn:agi-folder:otitis_media ! Otitis media
