name: AXL Receptor Tyrosine Kinase Signaling
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:signal_transduction_pathways ! Signal transduction pathways
is_a: urn:agi-folder:generic ! Generic
is_a: urn:agi-folder:a ! A
xref: PS:Description "TAM receptors is a subfamily of receptor protein tyrosine kinases (RTKs), including AXL, MERTK and TYRO3. Pathway is built manually using published studies."
synonym: "Description: TAM receptors is a subfamily of receptor protein tyrosine kinases (RTKs), including AXL, MERTK and TYRO3. Pathway is built manually using published studies." EXACT []
