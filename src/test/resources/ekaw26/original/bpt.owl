[Term]
id: urn:agi-pathway:uuid-bae9e3a9-7998-48a2-a0a0-775982d05586
name: CRH Secretion Regulation
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:peptide_and_protein_hormones ! Peptide and protein hormones
is_a: urn:agi-folder:nervous_system ! Nervous system
is_a: urn:agi-folder:c ! C
xref: PS:Description "CRH secretion is regulated by catecholamines, serotonin and several others biologically active substances. Pathway is built manually using published studies."
synonym: "Description: CRH secretion is regulated by catecholamines, serotonin and several others biologically active substances. Pathway is built manually using published studies." EXACT []
xref: PS:PMID "12852256"
