id: urn:agi-pathway:uuid-304b6703-4d63-4925-8345-8fe65339b3b0
name: Diabetes Induced Cataract
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:d ! D
is_a: urn:agi-folder:cataract ! Cataract
