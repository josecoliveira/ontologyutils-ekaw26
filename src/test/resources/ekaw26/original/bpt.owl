synonym: "Pathway_Author: A. Nesterova ORCID:0000-0002-9448-8101" EXACT []
xref: PS:Link "https://mammal-profservices.pathwaystudio.com/app/sd?urn=urn:agi-pathway:uuid-70ffda9b-ce38-4486-ba2b-39195987ae09"
synonym: "Link: https://mammal-profservices.pathwaystudio.com/app/sd?urn=urn:agi-pathway:uuid-70ffda9b-ce38-4486-ba2b-39195987ae09" EXACT []
