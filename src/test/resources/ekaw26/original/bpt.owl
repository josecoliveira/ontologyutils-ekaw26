id: urn:agi-pathway:uuid-2906d5c4-4ee5-4223-95b1-a5b1ad74e5fa
name: 1_Dysfunction of cochlear hair cell stereocilia proteins in hearing loss
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:1 ! 1
is_a: urn:agi-folder:hearing_loss ! Hearing loss
