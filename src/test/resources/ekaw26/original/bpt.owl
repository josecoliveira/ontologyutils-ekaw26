name: 3_Arterial wall inflammation and calcification in atherosclerosis
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:3 ! 3
is_a: urn:agi-folder:atherosclerosis ! Atherosclerosis
