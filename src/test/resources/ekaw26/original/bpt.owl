[Term]
id: urn:agi-pathway:uuid-99105a97-3698-45a2-b161-71623b7bc5b2
name: Norepinephrine Neuronal Release
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:secretory_vesicle ! Secretory vesicle
is_a: urn:agi-folder:nervous_system ! Nervous system
is_a: urn:agi-folder:amino_acid_derived_hormones ! Amino acid derived hormones
is_a: urn:agi-folder:nerve_tissue ! Nerve tissue
is_a: urn:agi-folder:synapse ! Synapse
is_a: urn:agi-folder:n ! N
xref: PS:Description "Norepinephrine is released from presynaptic nerve terminals of adrenergic neuron by synaptic vesicle exocytosis. Pathway is built manually using published studies."
synonym: "Description: Norepinephrine is released from presynaptic nerve terminals of adrenergic neuron by synaptic vesicle exocytosis. Pathway is built manually using published studies." EXACT []
xref: PS:PMID "28167663"
xref: PS:PMID "22026965"
xref: PS:PMID "24054156"
synonym: "PMID: 28167663" EXACT []
synonym: "PMID: 22026965" EXACT []
synonym: "PMID: 24054156" EXACT []
xref: PS:Pathway_Author "M. Zharkova  ORCID:0000-0001-8706-9411"
synonym: "Pathway_Author: M. Zharkova  ORCID:0000-0001-8706-9411" EXACT []
xref: PS:Link "https://mammal-profservices.pathwaystudio.com/app/sd?urn=urn:agi-pathway:uuid-99105a97-3698-45a2-b161-71623b7bc5b2"
