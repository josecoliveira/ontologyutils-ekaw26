id: urn:agi-pathway:uuid-a10a23f6-67c7-43f1-a5cd-99c29c9ec4f0
name: CXC Chemokine Receptor Signaling
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:chemotaxis ! Chemotaxis
is_a: urn:agi-folder:generic ! Generic
is_a: urn:agi-folder:c ! C
xref: PS:Description "There are 17 identified CXC chemokines in mammals. Pathway is built manually using published studies."
synonym: "Description: There are 17 identified CXC chemokines in mammals. Pathway is built manually using published studies." EXACT []
xref: PS:Pathway_Author "V. Sobolev ORCID:0000-0003-4779-156X"
synonym: "Pathway_Author: V. Sobolev ORCID:0000-0003-4779-156X" EXACT []
