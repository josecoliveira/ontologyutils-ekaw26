id: urn:agi-pathway:uuid-9f961bae-7233-48d2-9d01-2196f685b28e
name: Uric Acid Excretion Impairement in Kidney in Gout
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:u ! U
is_a: urn:agi-folder:urinary_tract ! Urinary tract
