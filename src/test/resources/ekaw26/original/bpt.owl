id: urn:agi-pathway:uuid-b324081c-10fa-45ae-8dd5-e7e6e13f8ff5
name: 3_Islet beta-cell destruction in T1D
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:diabetes_mellitus_type_1 ! Diabetes mellitus type 1
is_a: urn:agi-folder:3 ! 3
