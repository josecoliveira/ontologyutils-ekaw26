id: urn:agi-pathway:uuid-326b8a11-8ea1-469a-b963-1e86a3985178
name: VEGFA/NOTCH1/WNT Cross-talk in Blood Vessel Sprouting and Branching in Cancer
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
