[Term]
id: urn:agi-pathway:uuid-87736807-c3f0-4428-abcb-300fa1d545f0
name: Familial Mediterranean Fever
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:f ! F
is_a: urn:agi-folder:familial_mediterranean_fever ! Familial mediterranean fever
is_a: urn:agi-folder:hematological_system ! Hematological system
xref: PS:Description "Familial Mediterranean fever (FMF) is the most common monogenic autoinflammatory disease worldwide and has an autosomal recessive inheritance. Pathway is built manually using published studies."
synonym: "Description: Familial Mediterranean fever (FMF) is the most common monogenic autoinflammatory disease worldwide and has an autosomal recessive inheritance. Pathway is built manually using published studies." EXACT []
xref: PS:PMID "24247370"
