xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:generic ! Generic
is_a: urn:agi-folder:mitochondria ! Mitochondria
is_a: urn:agi-folder:proteasome ! Proteasome
is_a: urn:agi-folder:p ! P
is_a: urn:agi-folder:proteome_instability_associated_with_aging ! Proteome instability associated with aging
xref: PS:Description "Insoluble aggregations of proteins impair the cell function and may lead to the cell senescence. Pathway is built manually using published studies."
synonym: "Description: Insoluble aggregations of proteins impair the cell function and may lead to the cell senescence. Pathway is built manually using published studies." EXACT []
