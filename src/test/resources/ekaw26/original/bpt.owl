id: urn:agi-pathway:uuid-ab581f90-c839-46f5-937a-97a70efa2779
name: Centriole Duplication and Separation
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:nucleus ! Nucleus
is_a: urn:agi-folder:generic ! Generic
is_a: urn:agi-folder:cell_division ! Cell division
is_a: urn:agi-folder:c ! C
is_a: urn:agi-folder:chromosome ! Chromosome
xref: PS:Description "A centriole is a cylinder shaped cell structure found in most eukaryotic cells that is comprised of nine triplets of microtubules in the cytoplasm. Pathway is built manually using published studies."
synonym: "Description: A centriole is a cylinder shaped cell structure found in most eukaryotic cells that is comprised of nine triplets of microtubules in the cytoplasm. Pathway is built manually using published studies." EXACT []
xref: PS:Pathway_Author "A. Nesterova ORCID:0000-0002-9448-8101"
synonym: "Pathway_Author: A. Nesterova ORCID:0000-0002-9448-8101" EXACT []
