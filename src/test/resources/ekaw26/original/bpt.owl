name: 2_The role of aldosterone in the regulation of Na+/Cl-/K+ homeostasis
xref: PS:NodeType "Pathway"
synonym: "NodeType: Pathway" EXACT []
is_a: urn:agi-folder:hypertension_arterial ! Hypertension arterial
is_a: urn:agi-folder:2 ! 2
