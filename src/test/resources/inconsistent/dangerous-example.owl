    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/josecoliveira/ontologies/dangerous-example#A -->

    <owl:Class rdf:about="http://www.semanticweb.org/josecoliveira/ontologies/dangerous-example#A">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/josecoliveira/ontologies/dangerous-example#R"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/josecoliveira/ontologies/dangerous-example#A"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- 
